{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "IdentitySettings": {
    "Core": {
      "Db": {
        "DbSchema": "identity",
        "ConnectionString": "Host=localhost;Port=5435;Database=identity_db;Username=postgres;Password=postgres"
      }
    }
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatShouldBeAtLeast32CharactersLong!",
    "Issuer": "tickethub-issuer",
    "Audience": "tickethub-audience",
    "ExpiryMinutes": "60"
  },
  "Port": "5001",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:4200",
      "http://localhost:5173"
    ]
  }
}
