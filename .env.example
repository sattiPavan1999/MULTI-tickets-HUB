# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres

# JWT secret shared by identity-service and admin-bff (must be >= 32 chars)
JWT_SECRET_KEY=replace-with-strong-random-string-min-32-chars

# JWT secret used by api-gateway
JWT_GATEWAY_SECRET_KEY=replace-with-strong-random-string-min-32-chars
